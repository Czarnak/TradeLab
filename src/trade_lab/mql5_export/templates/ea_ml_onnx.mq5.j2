//+------------------------------------------------------------------+
//| {{ ea_name }}                                                    |
//| Auto-generated by TradeLab — do not edit manually.              |
//| {{ ea_description }}                                             |
//+------------------------------------------------------------------+
#property copyright "TradeLab"
#property description "{{ ea_description }}"
#property version   "1.00"
#property strict

#include <Trade\Trade.mqh>

//+------------------------------------------------------------------+
//| Input parameters                                                 |
//+------------------------------------------------------------------+

// --- EA settings ---
input int    MagicNumber  = {{ magic_number }};
input int    MaxSpread    = {{ max_spread }};

// --- Signal thresholds ---
input double EntryThreshold = {{ "%.4f"|format(config.entry_threshold) }};
input double ExitThreshold  = {{ "%.4f"|format(config.exit_threshold) }};

// --- Feature inputs (populate with live indicator values in OnTick) ---
{% for name in config.feature_names %}
input double Feature_{{ loop.index0 }}_{{ name | replace("__", "_") | replace(".", "_") }} = 0.0;
{% endfor %}

// --- Position sizing ---
{% set sizing = config.sizing %}
{% if sizing.sizer_type == "none" %}
input double LotSize = 0.1;
{% elif sizing.sizer_type == "fixed" %}
input double SizingFraction = {{ "%.4f"|format(sizing.params.fraction) }};  // Fraction of balance per trade
{% elif sizing.sizer_type == "risk_based" %}
input double MaxFraction    = {{ "%.4f"|format(sizing.params.max_fraction) }};    // Max fraction of balance at full conviction
input double RiskMultiplier = {{ "%.4f"|format(sizing.params.risk_multiplier) }}; // ATR multiples of risk per unit
{% endif %}

//+------------------------------------------------------------------+
//| Global variables                                                 |
//+------------------------------------------------------------------+
CTrade  trade;
long    OnnxModel  = INVALID_HANDLE;
{% if sizing.sizer_type == "risk_based" %}
int     AtrHandle  = INVALID_HANDLE;
{% endif %}

//--- ONNX model filename (must be in MQL5\Files\ on the MT5 data folder)
const string ONNX_FILENAME = "{{ onnx_filename }}";

//+------------------------------------------------------------------+
//| Helper: detect a new bar                                         |
//+------------------------------------------------------------------+
bool IsNewBar()
{
    static datetime last_bar_time = 0;
    datetime current_bar_time = iTime(_Symbol, PERIOD_CURRENT, 0);
    if(current_bar_time != last_bar_time)
    {
        last_bar_time = current_bar_time;
        return true;
    }
    return false;
}

//+------------------------------------------------------------------+
//| Helper: normalise lot size to broker constraints                 |
//+------------------------------------------------------------------+
double NormalizeLots(double lots)
{
    double min_lot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
    double max_lot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
    double lot_step = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
    lots = MathRound(lots / lot_step) * lot_step;
    lots = MathMax(min_lot, MathMin(max_lot, lots));
    return lots;
}

//+------------------------------------------------------------------+
//| Run ONNX model inference                                         |
//| Returns raw model output (signal_strength) in the range         |
//| expected by the strategy (tanh output → [-1, 1]).               |
//+------------------------------------------------------------------+
double ComputeOnnxSignal()
{
    // Build a 1×N_FEATURES input matrix from the Feature_* inputs.
    // MT5 OnnxRun uses matrix / vector types introduced in build 3490+.
    const int N = {{ config.n_features }};

    // Collect feature values in declaration order.
    double raw_features[{{ config.n_features }}] = {
{% for name in config.feature_names %}
        Feature_{{ loop.index0 }}_{{ name | replace("__", "_") | replace(".", "_") }}{% if not loop.last %},{% endif %}

{% endfor %}
    };

    // Convert to matrix row (required by OnnxRun shape [1, N]).
    matrix input_mat(1, N);
    for(int i = 0; i < N; i++)
        input_mat[0][i] = raw_features[i];

    matrix output_mat(1, 1);

    if(!OnnxRun(OnnxModel,
                ONNX_DEFAULT,
                input_mat,
                output_mat))
    {
        Print("OnnxRun failed, error: ", GetLastError());
        return 0.0;
    }

    return output_mat[0][0];
}

//+------------------------------------------------------------------+
//| Expert initialisation                                            |
//+------------------------------------------------------------------+
int OnInit()
{
    trade.SetExpertMagicNumber(MagicNumber);
    trade.SetDeviationInPoints(10);

    // Load ONNX model from MQL5\Files\
    OnnxModel = OnnxCreate(ONNX_FILENAME, ONNX_DEFAULT);
    if(OnnxModel == INVALID_HANDLE)
    {
        Print("Failed to load ONNX model '", ONNX_FILENAME,
              "'. Error: ", GetLastError(),
              ". Place the .onnx file in the MT5 data folder under MQL5\\Files\\.");
        return INIT_FAILED;
    }

    // Declare input shape: batch=1, features={{ config.n_features }}
    ulong input_shape[] = {1, {{ config.n_features }}};
    if(!OnnxSetInputShape(OnnxModel, 0, input_shape))
    {
        Print("OnnxSetInputShape failed, error: ", GetLastError());
        return INIT_FAILED;
    }

    // Declare output shape: batch=1, output=1
    ulong output_shape[] = {1, 1};
    if(!OnnxSetOutputShape(OnnxModel, 0, output_shape))
    {
        Print("OnnxSetOutputShape failed, error: ", GetLastError());
        return INIT_FAILED;
    }

{% if sizing.sizer_type == "risk_based" %}
    AtrHandle = iATR(_Symbol, PERIOD_CURRENT, 14);
    if(AtrHandle == INVALID_HANDLE)
    {
        Print("Failed to create ATR handle, error: ", GetLastError());
        return INIT_FAILED;
    }
{% endif %}

    Print("{{ ea_name }} initialised. ONNX model loaded: ", ONNX_FILENAME);
    return INIT_SUCCEEDED;
}

//+------------------------------------------------------------------+
//| Expert deinitialization                                          |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
    if(OnnxModel != INVALID_HANDLE)
    {
        OnnxRelease(OnnxModel);
        OnnxModel = INVALID_HANDLE;
    }
{% if sizing.sizer_type == "risk_based" %}
    if(AtrHandle != INVALID_HANDLE)
    {
        IndicatorRelease(AtrHandle);
        AtrHandle = INVALID_HANDLE;
    }
{% endif %}
}

//+------------------------------------------------------------------+
//| Expert tick function                                             |
//+------------------------------------------------------------------+
void OnTick()
{
    if(!IsNewBar()) return;

    // Spread filter
    long current_spread = SymbolInfoInteger(_Symbol, SYMBOL_SPREAD);
    if(current_spread > MaxSpread) return;

    // Run ONNX model
    double signal_strength = ComputeOnnxSignal();

    // --- Position sizing ---
{% if sizing.sizer_type == "none" %}
    double lots = NormalizeLots(LotSize);
{% elif sizing.sizer_type == "fixed" %}
    double balance  = AccountInfoDouble(ACCOUNT_BALANCE);
    double price    = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
    double lots     = NormalizeLots((balance * SizingFraction) / price);
{% elif sizing.sizer_type == "risk_based" %}
    double atr_buf[1];
    double atr_value = 0.0;
    if(CopyBuffer(AtrHandle, 0, 1, 1, atr_buf) == 1)
        atr_value = atr_buf[0];

    // Mirrors RiskBasedPositionSizer.compute_size():
    //   units = equity * max_fraction * |signal| / (ATR * risk_multiplier)
    // No volatility reading -> size 0 (no trade), same as the Python sizer.
    double balance    = AccountInfoDouble(ACCOUNT_BALANCE);
    double conviction = MathAbs(signal_strength);
    double lots = 0.0;
    if(atr_value > 0)
        lots = NormalizeLots((balance * MaxFraction * conviction) / (atr_value * RiskMultiplier));
{% endif %}

    // --- Trade logic ---
{% include "helpers/trade_logic.mq5.j2" %}
}
//+------------------------------------------------------------------+
