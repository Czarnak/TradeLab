//====================================================================
// SECTION 5 — OnInit
//====================================================================
int OnInit()
  {
   trade.SetExpertMagicNumber(MagicNumber);

   //--- Create indicator handles ---
{% for ind in indicators %}
{% if ind.is_ma_type %}
   // {{ ind.class_name }}(period={{ ind.params.period }}) → iMA with {{ ind.ma_method }}
   handle_{{ ind.var_name }} = iMA(_Symbol, {{ timeframe }},
                                   {{ ind.input_prefix }}_Period, 0,
                                   {{ ind.ma_method }},
                                   {{ ind.input_prefix }}_Price);
{% elif ind.indicator_type == 'rsi' %}
   // RSI(period={{ ind.params.period }}) → iRSI
   handle_{{ ind.var_name }} = iRSI(_Symbol, {{ timeframe }},
                                    {{ ind.input_prefix }}_Period,
                                    {{ ind.input_prefix }}_Price);
{% elif ind.indicator_type == 'macd' %}
   // MACD(fast={{ ind.params.fast_period }}, slow={{ ind.params.slow_period }}) → iMACD, buffer 1 = signal line
   handle_{{ ind.var_name }} = iMACD(_Symbol, {{ timeframe }},
                                     {{ ind.input_prefix }}_FastPeriod,
                                     {{ ind.input_prefix }}_SlowPeriod,
                                     9,
                                     {{ ind.input_prefix }}_Price);
{% else %}
   // {{ ind.class_name }} uses a custom computation — no handle needed.
{% endif %}
{% endfor %}
{% if config.sizing.sizer_type == 'risk_based' %}
   handle_atr = iATR(_Symbol, {{ timeframe }}, ATR_Period);
{% endif %}

   //--- Validate handles ---
{% for ind in indicators %}
{% if ind.uses_builtin_handle %}
   if(handle_{{ ind.var_name }} == INVALID_HANDLE)
     {
      PrintFormat("OnInit: Failed to create {{ ind.class_name }} handle ({{ ind.var_name }}), error %d", GetLastError());
      return INIT_FAILED;
     }
{% endif %}
{% endfor %}
{% if config.sizing.sizer_type == 'risk_based' %}
   if(handle_atr == INVALID_HANDLE)
     {
      PrintFormat("OnInit: Failed to create ATR handle, error %d", GetLastError());
      return INIT_FAILED;
     }
{% endif %}

   //--- Strategy summary ---
   Print("========== TradeLab EA Initialised ==========");
   PrintFormat("  EA        : {{ ea_name }}");
   PrintFormat("  Symbol    : %s  Timeframe : {{ timeframe }}", _Symbol);
   PrintFormat("  Entry thr : %.4f   Exit thr : %.4f", EntryThreshold, ExitThreshold);
   Print("  Allow long : {{ 'true' if config.allow_long else 'false' }}   Allow short : {{ 'true' if config.allow_short else 'false' }}");
   Print("  Indicators:");
{% for ind in indicators %}
   PrintFormat("    [{{ loop.index0 }}] {{ ind.class_name }}({% for k, v in ind.params.items() %}{{ k }}={{ v }}{% if not loop.last %}, {% endif %}{% endfor %})  weight=%.4f",
               Weight_{{ ind.input_prefix }});
{% endfor %}
   PrintFormat("  Sizing    : {{ config.sizing.sizer_type }}");
   Print("=============================================");

   return INIT_SUCCEEDED;
  }

//====================================================================
// SECTION 6 — OnDeinit
//====================================================================
void OnDeinit(const int reason)
  {
{% for ind in indicators %}
{% if ind.uses_builtin_handle %}
   IndicatorRelease(handle_{{ ind.var_name }});
{% endif %}
{% endfor %}
{% if config.sizing.sizer_type == 'risk_based' %}
   IndicatorRelease(handle_atr);
{% endif %}
  }

//====================================================================
// SECTION 7 — OnTick
//====================================================================
void OnTick()
  {
   //--- Bar-open guard: only act once per completed bar ---
   if(!IsNewBar()) return;

   double trailing_weighted_sum =
{% for ind in indicators %}
      Weight_{{ ind.input_prefix }} * Get{{ ind.function_name }}Strength()
{% if not loop.last %}
      +
{% endif %}
{% endfor %}
      ;
   double trailing_signal_strength = MathTanh(trailing_weighted_sum);
   ManageTrailingStop(trailing_signal_strength);

   //--- Spread guard: skip when market conditions are poor ---
   long current_spread = SymbolInfoInteger(_Symbol, SYMBOL_SPREAD);
   if(current_spread > MaxSpreadPts)
     {
      PrintFormat("Spread %d pts > limit %d pts — skipping.", current_spread, MaxSpreadPts);
      return;
     }

   //--- Combined signal strength ---
   // Python: signal_strength = tanh(Σ weight_i × indicator_i.to_signal_strength())
   double weighted_sum =
{% for ind in indicators %}
      Weight_{{ ind.input_prefix }} * Get{{ ind.function_name }}Strength()
{% if not loop.last %}
      +
{% endif %}
{% endfor %}
      ;
   double signal_strength = MathTanh(weighted_sum);

   //--- Lot calculation ---
   // Python: position_sizer.compute_size(signal_strength, equity, price, volatility)
{% if config.sizing.sizer_type == 'none' %}
   double lots = NormalizeLots(Lots);
{% elif config.sizing.sizer_type == 'fixed' %}
   double ask_price = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double lots = (ask_price > 0.0)
                 ? NormalizeLots(AccountInfoDouble(ACCOUNT_BALANCE) * SizingFraction / ask_price)
                 : 0.0;
   if(lots <= 0.0) return;
{% elif config.sizing.sizer_type == 'risk_based' %}
   double balance      = AccountInfoDouble(ACCOUNT_BALANCE);
   double risk_capital = balance * MaxFraction * MathAbs(signal_strength);
   double atr_val      = 0.0;
   if(CopyBuffer(handle_atr, 0, 0, 1, buf_atr) > 0)
      atr_val = buf_atr[0];
   double lots = (atr_val > 0.0)
                 ? NormalizeLots(risk_capital / (atr_val * RiskMultiplier))
                 : 0.0;
   if(lots <= 0.0) return;
{% endif %}

   //--- Trade logic ---
   // Python: StandardStrategy entry/exit threshold interpretation
   bool has_long  = false;
   bool has_short = false;
   if(PositionSelect(_Symbol))
     {
      if((long)PositionGetInteger(POSITION_MAGIC) == MagicNumber)
        {
         has_long  = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY);
         has_short = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_SELL);
        }
     }

{% if config.allow_long %}
   if(has_long)
     {
      bool exit_neutral = (signal_strength < ExitThreshold);
{% if config.allow_short %}
      bool exit_for_short = (signal_strength < -EntryThreshold);
{% else %}
      bool exit_for_short = false;
{% endif %}
      if(exit_neutral || exit_for_short)
         trade.PositionClose(_Symbol);
     }
{% endif %}

{% if config.allow_short %}
   if(has_short)
     {
      bool exit_neutral = (signal_strength > -ExitThreshold);
{% if config.allow_long %}
      bool exit_for_long = (signal_strength > EntryThreshold);
{% else %}
      bool exit_for_long = false;
{% endif %}
      if(exit_neutral || exit_for_long)
         trade.PositionClose(_Symbol);
     }
{% endif %}

   has_long  = false;
   has_short = false;
   if(PositionSelect(_Symbol))
     {
      if((long)PositionGetInteger(POSITION_MAGIC) == MagicNumber)
        {
         has_long  = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY);
         has_short = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_SELL);
        }
     }

{% if config.allow_long %}
   if(!has_long && !has_short && signal_strength > EntryThreshold)
     {
      double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
{% if config.risk.tp_type == 'fixed' and config.risk.tp_base_points is not none %}
      double tp_price = ask + TP_BasePoints * _Point;
{% elif config.risk.tp_type == 'signal_strength' and config.risk.tp_base_points is not none %}
      double tp_price = ask + signal_strength * TP_BasePoints * _Point;
{% else %}
      double tp_price = 0.0;
{% endif %}
{% if config.risk.sl_type == 'fixed' and config.risk.sl_base_points is not none %}
      double sl_price = ask - SL_BasePoints * _Point;
{% elif config.risk.sl_type == 'signal_strength' and config.risk.sl_base_points is not none %}
      double sl_price = ask - signal_strength * SL_BasePoints * _Point;
{% else %}
      double sl_price = 0.0;
{% endif %}
      trade.Buy(lots, _Symbol, ask, sl_price, tp_price, "TradeLab");
     }
{% endif %}
{% if config.allow_short %}
   if(!has_long && !has_short && signal_strength < -EntryThreshold)
     {
      double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
{% if config.risk.tp_type == 'fixed' and config.risk.tp_base_points is not none %}
      double tp_price = bid - TP_BasePoints * _Point;
{% elif config.risk.tp_type == 'signal_strength' and config.risk.tp_base_points is not none %}
      double tp_price = bid + signal_strength * TP_BasePoints * _Point;
{% else %}
      double tp_price = 0.0;
{% endif %}
{% if config.risk.sl_type == 'fixed' and config.risk.sl_base_points is not none %}
      double sl_price = bid + SL_BasePoints * _Point;
{% elif config.risk.sl_type == 'signal_strength' and config.risk.sl_base_points is not none %}
      double sl_price = bid - signal_strength * SL_BasePoints * _Point;
{% else %}
      double sl_price = 0.0;
{% endif %}
      trade.Sell(lots, _Symbol, bid, sl_price, tp_price, "TradeLab");
     }
{% endif %}

  }
