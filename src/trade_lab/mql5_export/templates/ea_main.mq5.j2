//------------------------------------------------------------------
// IsNewBar(): detect bar open — only trade once per completed bar.
//------------------------------------------------------------------
bool IsNewBar()
  {
   static datetime s_last_bar = 0;
   datetime current_bar = iTime(_Symbol, PERIOD_CURRENT, 0);
   if(current_bar != s_last_bar)
     {
      s_last_bar = current_bar;
      return true;
     }
   return false;
  }

//------------------------------------------------------------------
// NormalizeLots(lots): clamp to broker min/max/step constraints.
//------------------------------------------------------------------
double NormalizeLots(double lots)
  {
   double min_lot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double max_lot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   double lot_step = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   lots = MathMax(min_lot, MathMin(max_lot, lots));
   lots = MathRound(lots / lot_step) * lot_step;
   return NormalizeDouble(lots, 2);
  }

//------------------------------------------------------------------
// ManageTrailingStop(): update broker-side trailing stop on open positions.
//------------------------------------------------------------------
void ManageTrailingStop(double signal_strength)
  {
{% if config.risk.ts_type in ('fixed', 'signal_strength') and config.risk.ts_base_points is not none and config.risk.ts_step_points is not none %}
   for(int i = PositionsTotal() - 1; i >= 0; i--)
     {
      ulong ticket = PositionGetTicket(i);
      if(ticket == 0 || !PositionSelectByTicket(ticket))
         continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol)
         continue;
      if((long)PositionGetInteger(POSITION_MAGIC) != MagicNumber)
         continue;

      long position_type = PositionGetInteger(POSITION_TYPE);
      double current_sl = PositionGetDouble(POSITION_SL);
      double current_tp = PositionGetDouble(POSITION_TP);

      if(position_type == POSITION_TYPE_BUY)
        {
         double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
{% if config.risk.ts_type == 'fixed' %}
         double new_sl = bid - TS_BasePoints * _Point;
{% else %}
         double new_sl = bid - signal_strength * TS_BasePoints * _Point;
{% endif %}
         if(current_sl == 0.0 || (new_sl - current_sl) >= TS_StepPoints * _Point)
            trade.PositionModify(ticket, new_sl, current_tp);
        }
      else if(position_type == POSITION_TYPE_SELL)
        {
         double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
{% if config.risk.ts_type == 'fixed' %}
         double new_sl = ask + TS_BasePoints * _Point;
{% else %}
         double new_sl = ask - signal_strength * TS_BasePoints * _Point;
{% endif %}
         if(current_sl == 0.0 || (current_sl - new_sl) >= TS_StepPoints * _Point)
            trade.PositionModify(ticket, new_sl, current_tp);
        }
     }
{% else %}
   return;
{% endif %}
  }

//------------------------------------------------------------------
// GetAppliedPrice(shift, price): OHLC value for given bar and price type.
// Used by RollingStd() and custom indicator implementations.
//------------------------------------------------------------------
double GetAppliedPrice(int shift, ENUM_APPLIED_PRICE price)
  {
   switch(price)
     {
      case PRICE_OPEN:  return iOpen(_Symbol, PERIOD_CURRENT, shift);
      case PRICE_HIGH:  return iHigh(_Symbol, PERIOD_CURRENT, shift);
      case PRICE_LOW:   return iLow(_Symbol, PERIOD_CURRENT, shift);
      case PRICE_CLOSE:
      default:          return iClose(_Symbol, PERIOD_CURRENT, shift);
     }
  }

//------------------------------------------------------------------
// RollingStd(period, shift, price): rolling sample std deviation.
// Python equivalent: price.rolling(period).std()  [ddof=1, pandas default]
// Used by MA-type signal strength functions.
//------------------------------------------------------------------
double RollingStd(int period, int shift, ENUM_APPLIED_PRICE price)
  {
   if(period < 2) return 0.0;
   double sum = 0.0, sum_sq = 0.0;
   for(int i = shift; i < shift + period; i++)
     {
      double p = GetAppliedPrice(i, price);
      sum    += p;
      sum_sq += p * p;
     }
   // Sample variance: (Σx² - (Σx)²/n) / (n-1)
   double variance = (sum_sq - sum * sum / period) / (period - 1);
   return variance > 0.0 ? MathSqrt(variance) : 0.0;
  }

