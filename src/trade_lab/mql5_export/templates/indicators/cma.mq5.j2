{#
  indicators/cma.mq5.j2  —  Standalone signal-strength function for CMA.
  -----------------------------------------------------------------------
  This template renders a complete GetXxxStrength() function for a single
  CMA (Cumulative/Expanding Moving Average) indicator. It is not included by
  ea_main.mq5.j2 (which delegates to helpers/signal_strength.mq5.j2 inline);
  it exists as a focused, self-contained reference implementation.

  CMA uses no builtin MQL5 indicator handle — values are computed by looping
  over all available bars each tick (computationally intensive for deep history).

  Important: The expanding window resets every time the EA is restarted.
  Values will be transient until enough bars have accumulated (expect initial
  noise on the first session after deployment or Strategy Tester restarts).

  Required context variables (from enriched IndicatorConfig dict):
    ind.function_name : str    e.g. 'CMA'
    ind.input_prefix  : str    e.g. 'CMA'
    ind.applied_price : str    e.g. 'PRICE_CLOSE'
    ind.params        : dict   {'period': 20, 'column': 'Close'}
    ind.weight        : float

  Prerequisites in the generated EA:
    GetAppliedPrice()  — helper declared in SECTION 3
    RollingStd()       — helper declared in SECTION 3
#}
//------------------------------------------------------------------
// Get{{ ind.function_name }}Strength()
// Python: CMA({% for k, v in ind.params.items() %}{{ k }}={{ v }}{% if not loop.last %}, {% endif %}{% endfor %}).to_signal_strength(df)
// Formula: tanh((price - expanding_mean) / rolling_std(period))
// CMA = cumulative (expanding) mean over all available history.
// WARNING: expanding window resets on EA restart — transient behaviour
//          until sufficient bars have been loaded from history.
// Weight in combined formula: {{ "%.4f"|format(ind.weight) }}
//------------------------------------------------------------------
double Get{{ ind.function_name }}Strength()
  {
   int total = iBars(_Symbol, PERIOD_CURRENT);
   if(total < {{ ind.input_prefix }}_Period) return 0.0;
   // Sum all available bars to compute the expanding mean.
   double sum = 0.0;
   for(int i = 0; i < total; i++)
      sum += GetAppliedPrice(i, {{ ind.applied_price }});
   double cma_val = sum / total;
   double price   = GetAppliedPrice(0, {{ ind.applied_price }});
   double std_val = RollingStd({{ ind.input_prefix }}_Period, 0, {{ ind.applied_price }});
   if(std_val == 0.0) return 0.0;
   return MathTanh((price - cma_val) / std_val);
  }
