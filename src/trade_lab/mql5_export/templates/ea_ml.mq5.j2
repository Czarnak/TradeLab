{#
  ea_ml.mq5.j2  —  Master template for TradeLab ML MQL5 Expert Advisor
  -----------------------------------------------------------------------
  Generated by TradeLab mql5_export module (ML path).
  Do NOT edit this file directly — regenerate from Python instead.

  Template context variables
  --------------------------
  ea_name         : str
  ea_description  : str
  magic_number    : int
  max_spread      : int    (points)
  config          : MLStrategyConfig dataclass
                    .layers          : list[MLLayerConfig]
                    .feature_names   : list[str]
                    .n_features      : int
                    .entry_threshold : float
                    .exit_threshold  : float
                    .allow_long      : bool
                    .allow_short     : bool
                    .sizing          : SizingConfig

  Design notes
  ------------
  * Feature inputs are declared as individual `input double` variables.
    The user is responsible for connecting their live indicator values to
    these inputs — this is intentional (feature computation in MT5 is a
    separate concern from model inference).
  * The forward pass is rendered as a single `ComputeMLSignal()` function
    using statically allocated arrays. No heap allocation, no dynamic memory.
  * Weight arrays use C-style 2-D array initialiser lists. For large models
    this inflates the .mq5 file but avoids any OnInit-time loading logic.
  * Activation dispatch:
      relu    → MathMax(0.0, x)
      tanh    → MathTanh(x)
      sigmoid → 1.0 / (1.0 + MathExp(-x))
      linear  → x  (no wrapper)
#}
//+------------------------------------------------------------------+
//|                                              {{ ea_name }}        |
//|                                    Generated by TradeLab v0.6.0  |
//|                       https://github.com/Czarnak/TradeLab        |
//+------------------------------------------------------------------+
#property copyright   "TradeLab"
#property link        "https://github.com/Czarnak/TradeLab"
#property version     "1.00"
#property description "{{ ea_description }}"
#property strict

#include <Trade\Trade.mqh>

//====================================================================
// SECTION 1 — INPUT PARAMETERS
//====================================================================
input group            "=== Strategy Settings ==="
input double           EntryThreshold = {{ "%.4f"|format(config.entry_threshold) }};  // Enter trade when |signal_strength| exceeds this
input double           ExitThreshold  = {{ "%.4f"|format(config.exit_threshold) }};   // Close trade when |signal_strength| falls below this
input int              MagicNumber    = {{ magic_number }};    // Unique EA identifier for trade filtering
input int              MaxSpreadPts   = {{ max_spread }};      // Skip tick if spread (pts) exceeds this

// --- ML Model Feature Inputs ---
// These values feed directly into the neural network forward pass.
// Connect each input to your live indicator values via external EA logic,
// an include file, or by overriding these defaults in OnTick().
// Feature order matches the Python KerasModelWrapper.input_names list.
input group            "=== ML Feature Inputs ==="
{% for name in config.feature_names %}
input double           Feature_{{ loop.index0 }}_{{ name | replace("__", "_") | replace(" ", "_") }} = 0.0;  // Feature: {{ name }}
{% endfor %}

// --- Position Sizing ---
input group            "=== Position Sizing ==="
{% if config.sizing.sizer_type == 'none' %}
input double           Lots = 0.1;          // Fixed lot size per trade
{% elif config.sizing.sizer_type == 'fixed' %}
input double           SizingFraction = {{ "%.4f"|format(config.sizing.params.fraction) }};  // Fraction of balance per trade
{% elif config.sizing.sizer_type == 'risk_based' %}
input double           MaxFraction    = {{ "%.4f"|format(config.sizing.params.max_fraction) }};    // Max fraction of balance at full conviction
input double           RiskMultiplier = {{ "%.4f"|format(config.sizing.params.risk_multiplier) }}; // ATR multiples of risk per unit
input int              ATR_Period     = 14;   // ATR period for volatility estimate
{% endif %}

//====================================================================
// SECTION 2 — HARDCODED MODEL WEIGHTS
// Extracted from KerasModelWrapper at export time.
// Weights are frozen — retrain and re-export to update.
//====================================================================
{% for layer in config.layers %}
// Layer {{ layer.index }}: Dense({{ layer.units_in }} → {{ layer.units_out }}, activation={{ layer.activation }})
const double LAYER{{ layer.index }}_W[{{ layer.units_in }}][{{ layer.units_out }}] =
  {
{% for row in layer.weights %}
    { {% for val in row %}{{ "%.10f"|format(val) }}{% if not loop.last %}, {% endif %}{% endfor %} }{% if not loop.last %},{% endif %}

{% endfor %}
  };
const double LAYER{{ layer.index }}_B[{{ layer.units_out }}] =
  {
    {% for val in layer.biases %}{{ "%.10f"|format(val) }}{% if not loop.last %}, {% endif %}{% endfor %}

  };

{% endfor %}

//====================================================================
// SECTION 3 — GLOBAL VARIABLES
//====================================================================
CTrade trade;

{% if config.sizing.sizer_type == 'risk_based' %}
int    handle_atr;
double buf_atr[1];
{% endif %}

//====================================================================
// SECTION 4 — HELPER FUNCTIONS
//====================================================================

//------------------------------------------------------------------
// IsNewBar(): detect bar open — only trade once per completed bar.
//------------------------------------------------------------------
bool IsNewBar()
  {
   static datetime last_bar = 0;
   datetime current = iTime(_Symbol, PERIOD_CURRENT, 0);
   if(current != last_bar)
     {
      last_bar = current;
      return true;
     }
   return false;
  }

//------------------------------------------------------------------
// NormalizeLots(): clamp to broker min/max/step constraints.
//------------------------------------------------------------------
double NormalizeLots(double lots)
  {
   double min_lot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double max_lot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   double lot_step = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   lots = MathRound(lots / lot_step) * lot_step;
   return MathMax(min_lot, MathMin(max_lot, lots));
  }

//====================================================================
// SECTION 5 — NEURAL NETWORK FORWARD PASS
//====================================================================

//------------------------------------------------------------------
// ComputeMLSignal(): run the Dense forward pass and return the
// network output (expected range [-1, 1] for tanh output layer).
//
// Parameters
//   features[]  — array of {{ config.n_features }} feature value(s), one per input.
//                 Caller fills this from the Feature_N_* input variables.
//
// Python equivalent: KerasModelWrapper.predict(features_df).
//------------------------------------------------------------------
double ComputeMLSignal(const double &features[])
  {
{% for layer in config.layers %}
{% set is_last = loop.last %}
{% set prev_size = config.n_features if loop.first else config.layers[loop.index0 - 1].units_out %}
   // --- Layer {{ layer.index }}: {{ layer.units_out }} unit(s), {{ layer.activation }} ---
   double h{{ layer.index }}[{{ layer.units_out }}];
   for(int j{{ layer.index }} = 0; j{{ layer.index }} < {{ layer.units_out }}; j{{ layer.index }}++)
     {
      double s{{ layer.index }} = LAYER{{ layer.index }}_B[j{{ layer.index }}];
      for(int i{{ layer.index }} = 0; i{{ layer.index }} < {{ prev_size }}; i{{ layer.index }}++)
{% if loop.first %}
         s{{ layer.index }} += features[i{{ layer.index }}] * LAYER{{ layer.index }}_W[i{{ layer.index }}][j{{ layer.index }}];
{% else %}
         s{{ layer.index }} += h{{ loop.index0 - 1 }}[i{{ layer.index }}] * LAYER{{ layer.index }}_W[i{{ layer.index }}][j{{ layer.index }}];
{% endif %}
{% if layer.activation == 'relu' %}
      h{{ layer.index }}[j{{ layer.index }}] = MathMax(0.0, s{{ layer.index }});
{% elif layer.activation == 'tanh' %}
      h{{ layer.index }}[j{{ layer.index }}] = MathTanh(s{{ layer.index }});
{% elif layer.activation == 'sigmoid' %}
      h{{ layer.index }}[j{{ layer.index }}] = 1.0 / (1.0 + MathExp(-s{{ layer.index }}));
{% else %}
      h{{ layer.index }}[j{{ layer.index }}] = s{{ layer.index }};
{% endif %}
     }

{% endfor %}
   return h{{ config.layers | length - 1 }}[0];
  }

//====================================================================
// SECTION 6 — OnInit / OnDeinit
//====================================================================
int OnInit()
  {
{% if config.sizing.sizer_type == 'risk_based' %}
   handle_atr = iATR(_Symbol, PERIOD_CURRENT, ATR_Period);
   if(handle_atr == INVALID_HANDLE)
     {
      PrintFormat("OnInit: Failed to create ATR handle, error %d", GetLastError());
      return INIT_FAILED;
     }
{% endif %}

   Print("========== TradeLab ML EA Initialised ==========");
   PrintFormat("  EA          : {{ ea_name }}");
   PrintFormat("  Entry thr   : %.4f   Exit thr : %.4f", EntryThreshold, ExitThreshold);
   Print("  Allow long  : {{ 'true' if config.allow_long else 'false' }}   Allow short : {{ 'true' if config.allow_short else 'false' }}");
   PrintFormat("  Architecture: {{ config.layers | map(attribute='units_out') | list | join(' → ') }} ({{ config.n_features }} inputs)");
   PrintFormat("  Features    : {{ config.n_features }} input(s)");
   PrintFormat("  Sizing      : {{ config.sizing.sizer_type }}");
   Print("=================================================");

   return INIT_SUCCEEDED;
  }

void OnDeinit(const int reason)
  {
{% if config.sizing.sizer_type == 'risk_based' %}
   IndicatorRelease(handle_atr);
{% endif %}
  }

//====================================================================
// SECTION 7 — OnTick
//====================================================================
void OnTick()
  {
   //--- Bar-open guard: only act once per completed bar ---
   if(!IsNewBar()) return;

   //--- Spread guard: skip when market conditions are poor ---
   long current_spread = SymbolInfoInteger(_Symbol, SYMBOL_SPREAD);
   if(current_spread > MaxSpreadPts)
     {
      PrintFormat("Spread %d pts > limit %d pts — skipping.", current_spread, MaxSpreadPts);
      return;
     }

   //--- Assemble feature vector from inputs ---
   // Update Feature_N_* inputs with your live indicator values before
   // this point (e.g. via an include file or an OnCalculate()-style update).
   double features[{{ config.n_features }}] =
     {
{% for name in config.feature_names %}
       Feature_{{ loop.index0 }}_{{ name | replace("__", "_") | replace(" ", "_") }}{% if not loop.last %},{% endif %}  // {{ name }}
{% endfor %}
     };

   //--- Forward pass: compute signal_strength in [-1, 1] ---
   double signal_strength = ComputeMLSignal(features);

   //--- Lot sizing ---
{% if config.sizing.sizer_type == 'none' %}
   double lots = NormalizeLots(Lots);
   if(lots <= 0.0) return;
{% elif config.sizing.sizer_type == 'fixed' %}
   double ask_price = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double lots = (ask_price > 0.0)
                 ? NormalizeLots(AccountInfoDouble(ACCOUNT_BALANCE) * SizingFraction / ask_price)
                 : 0.0;
   if(lots <= 0.0) return;
{% elif config.sizing.sizer_type == 'risk_based' %}
   double balance      = AccountInfoDouble(ACCOUNT_BALANCE);
   double risk_capital = balance * MaxFraction * MathAbs(signal_strength);
   double atr_val      = 0.0;
   if(CopyBuffer(handle_atr, 0, 0, 1, buf_atr) > 0)
      atr_val = buf_atr[0];
   double lots = (atr_val > 0.0)
                 ? NormalizeLots(risk_capital / (atr_val * RiskMultiplier))
                 : 0.0;
   if(lots <= 0.0) return;
{% endif %}

   //--- Trade logic (mirrors StandardStrategy threshold interpretation) ---
{% include "helpers/trade_logic.mq5.j2" %}
  }
